{
  "manifestVersion": 2,
  "id": "workspace-namer",
  "name": "Tab Namer",
  "version": "0.2.0",
  "description": "Renames a conversation tab once its agent stops, using what that conversation was asked to do. Workspaces keep their names.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    }
  ],
  "contributes": {
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "hooks": [
      {
        "event": "agent.prompt.before"
      }
    ],
    "commands": [
      {
        "id": "namer.renameThis",
        "title": "Rename this conversation after its task",
        "when": "workspace"
      }
    ],
    "settings": [
      {
        "key": "enabled",
        "title": "Rename when an agent stops",
        "type": "boolean",
        "default": true
      },
      {
        "key": "useModel",
        "title": "Name with a local agent CLI",
        "type": "boolean",
        "default": true
      },
      {
        "key": "namerAgent",
        "title": "CLI used for naming (auto, pi, claude, codex)",
        "type": "string",
        "default": "auto",
        "description": "auto tries pi, then claude, then codex on PATH."
      },
      {
        "key": "namerModel",
        "title": "Model for naming",
        "type": "string",
        "default": "",
        "description": "Passed to the naming CLI; empty uses its default."
      },
      {
        "key": "maxTaskChars",
        "title": "Longest tab name (characters)",
        "type": "number",
        "default": 16,
        "minimum": 4,
        "maximum": 40
      },
      {
        "key": "timeoutMs",
        "title": "Naming timeout (ms)",
        "type": "number",
        "default": 60000,
        "minimum": 5000,
        "maximum": 300000
      }
    ]
  },
  "author": {
    "name": "zifengjiang",
    "url": "https://github.com/zifengjiang"
  },
  "repository": "https://github.com/zifengjiang/orca-workspace-namer",
  "homepage": "https://github.com/zifengjiang/orca-workspace-namer",
  "license": "MIT"
}
